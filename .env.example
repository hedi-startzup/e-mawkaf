# Copier ce fichier en .env puis remplir avec les valeurs du projet Supabase de l'équipe
# (Supabase → Project Settings → API). Uniquement l'URL et la clé publique
# (anon / publishable), jamais la clé secrète (sb_secret_... / service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mot de passe des comptes de démo créés par « npm run demo » (8 caractères au moins).
# Utilisé seulement par le script, jamais par l'appli. Ne pas mettre la valeur dans Vercel.
DEMO_MOT_DE_PASSE=
